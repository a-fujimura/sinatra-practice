<!DOCTYPE html>
<html lang="ja">

<head>
  <meta charset="UTF-8">
  <title>Hello Sinatra</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <article>
    <h1>メモアプリ</h1>
    <form action="/api/memos/add" method="post">
      <div class="form-items">
        <div class="form-items__item">
          <label>タイトル</label>
          <input type="text" name="title">
        </div>
        <div class="form-items__item">
          <label>内容</label>
          <textarea name="content"></textarea>
        </div>
      </div>
      <div class="form-action">
        <input type="submit" value="保存">
      </div>
    </form>
  </article>
</body>

</html>
