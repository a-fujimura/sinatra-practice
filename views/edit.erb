<!DOCTYPE html>
<html lang="ja">

<head>
  <meta charset="UTF-8">
  <title>Hello Sinatra</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <section>
    <h1>メモアプリ</h1>
    <section>
      <form action="/api/items/edit/<%= @item[:id] %>" method="post">
        <input type="hidden" name="_method" value="patch">
        <input type="text" value="<%= @item[:title] %>" name="title">
        <textarea name="content"><%= @item[:content] %></textarea>
        <input type="submit" value="保存">
      </form>
    </section>
  </section>
</body>

</html>
