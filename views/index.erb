<!DOCTYPE html>
<html lang="ja">

<head>
  <meta charset="UTF-8">
  <title>Hello Sinatra</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <article>
    <h1>メモアプリ</h1>
    <section>
      <h2>メモ一覧</h2>
      <ul>
        <% @memos.each do |memo| %>
          <li>
            <a href="<%= " /show/#{memo[:id]}" %>"><%= memo[:title] %></a>
          </li>
          <% end %>
      </ul>
      <form action="/new" method="get">
        <div class="form-action">
          <input type="submit" value="追加">
        </div>
      </form>
    </section>
  </article>
</body>

</html>
