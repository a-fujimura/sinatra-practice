<!DOCTYPE html>
<html lang="ja">

<head>
  <meta charset="UTF-8">
  <title>Hello Sinatra</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <section>
    <h1>メモアプリ</h1>
    <section>
      <form action="/new" method="get">
        <input type="submit" value="追加">
      </form>
      <ul>
        <% @items.each do |item| %>
          <li>
            <a href="<%= " /show/#{item[:id]}" %>"><%= item[:title] %></a>
          </li>
          <% end %>
      </ul>
    </section>
  </section>
</body>

</html>
